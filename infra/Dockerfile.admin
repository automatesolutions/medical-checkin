FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json* tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN npm install
RUN npm run build --workspace=@medical/admin
RUN npx esbuild apps/api/src/index.ts \
  --bundle \
  --platform=node \
  --target=node20 \
  --format=cjs \
  --outfile=apps/api/dist/server.cjs \
  --external:@electric-sql/pglite

FROM node:20-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production SERVICE_MODE=admin PORT=8080
COPY --from=build /app/apps/api/dist/server.cjs ./server.cjs
COPY --from=build /app/apps/admin/dist ./apps/admin/dist
ENV STATIC_DIR=/app/apps/admin/dist
EXPOSE 8080
CMD ["node", "server.cjs"]
