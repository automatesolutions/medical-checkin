# Root Dockerfile so Cloud Run "Connect repo" uses repo root as build context.
# Bundle the API to plain JS — tsx transpile-at-runtime is too slow/hangs on Cloud Run.
FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json* tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN npm install
RUN npm run build --workspace=@medical/checkin
RUN npx esbuild apps/api/src/index.ts \
  --bundle \
  --platform=node \
  --target=node20 \
  --format=cjs \
  --outfile=apps/api/dist/server.cjs \
  --external:@electric-sql/pglite

FROM node:20-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production SERVICE_MODE=checkin PORT=8080
COPY --from=build /app/apps/api/dist/server.cjs ./server.cjs
COPY --from=build /app/apps/checkin/dist ./apps/checkin/dist
ENV STATIC_DIR=/app/apps/checkin/dist
EXPOSE 8080
CMD ["node", "server.cjs"]
